@model Experience
@{
    ViewData["Title"] = "CreateExperience";
    Layout = "~/Views/Layout/Index.cshtml";
}

<h1>CreateExperience</h1>

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Tables</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Experience List</div>
					</div>
					<div class="card-body">
						
						<form method="post" class="form-control">
							<label>Experience Title</label>
							<input type="text" asp-for="Head" class="form-control" /> 
							<br />
							<label>Position</label>
							<input type="text" asp-for="Title" class="form-control" />
							<br />
							<label>Date</label>
							<input type="text" asp-for="Date" class="form-control" />
							<br />
							<label>Description </label>
							<textarea rows="4" asp-for="Description" class="form-control"></textarea>
							<br />
							<button class="btn btn-primary">Submit</button>
						</form>
						
					</div>
				</div>

			</div>

		</div>
	</div>
</div>