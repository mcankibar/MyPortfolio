@model List<Experience>
@{
    ViewData["Title"] = "ExperienceList";
    Layout = "~/Views/Layout/Index.cshtml";
}


	<div class="content">
		<div class="container-fluid">
			<h4 class="page-title">Tables</h4>
			<div class="row">
				<div class="col-md-12">
					<div class="card">
						<div class="card-header">
							<div class="card-title">Experience List</div>
						</div>
						<div class="card-body">
							<div class="card-sub">
								This is the basic table view of the ready dashboard :
							</div>
							<table class="table mt-3">
								<thead>
									<tr>
										<th scope="col">#</th>
										<th scope="col">Head</th>
										<th scope="col">Position</th>
										<th scope="col">Date</th>
										<th scope="col">Edit</th>
										<th scope="col">Delete</th>
									</tr>
								</thead>
								<tbody>
									@foreach(var item in Model){
										<tr>
											<td>@item.Id</td>
											<td>@item.Head</td>
											<td>@item.Title</td>
											<td>@item.Date</td>
										<td><a href="/Experience/UpdateExperience/@item.Id" class="btn btn-info">Edit</a></td>
										<td><a href="/Experience/DeleteExperience/@item.Id" class="btn btn-danger">Delete</a></td>
										<td></td>
										</tr>
										
									}
									
									
								</tbody>
							</table>
							<a href="/Experience/CreateExperience" class="btn btn-primary">Create</a>
						</div>
					</div>
					
				</div>
				
			</div>
		</div>
	</div>
	


